<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Compile Include="../../Core/*.cs" />
    <Compile Include="../LLMUnity로컬ModelAdapter.cs" />
    <Compile Include="LLMUnity로컬ModelAdapterTests.cs" />
    <Compile Include="$(VendorSourceRoot)/Runtime/LlamaLib/*.cs" />
  </ItemGroup>
  <Target Name="RequirePinnedSources" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(VendorSourceRoot)/Runtime/LlamaLib/LLMService.cs')" Text="VendorSourceRoot must name inspected LLMUnity 3.0.3 pinned source checkout." />
  </Target>
</Project>

MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1706950168}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.86, g: 0.91, b: 0.87, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 16
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\uC5F0\uACB0 \uC0C1\uD0DC  \uC2E4\uC81C \uAD00\uCE21 \uBBF8\uC218\uC9D1\n\uC790\uB8CC
    \uB2E8\uACC4  \uBA54\uD0C0\uB370\uC774\uD130 \uD655\uC778\n\n\uACF5\uC2DD \uCD9C\uCC98\n\uB18D\uB9BC\uC218\uC0B0\uC2DD\uD488\uAD50\uC721\uBB38\uD654\uC815\uBCF4\uC6D0
    \uD31C\uB9F5 \uAE30\uBC18 \uD1A0\uC591\uAC80\uC815 \uC815\uBCF4\nmafra-farmmap-soil-analysis\n\n\uC790\uB8CC
    ID  15058655\n\uC81C\uACF5\uAE30\uAD00  \uB18D\uB9BC\uC218\uC0B0\uC2DD\uD488\uAD50\uC721\uBB38\uD654\uC815\uBCF4\uC6D0\n\uACF5\uAC04
    \uAE30\uC900  \uC88C\uD45C\xB7PNU\xB7\uD31C\uB9F5 \uD544\uC9C0\n\uC2DC\uAC04
    \uAE30\uC900  \uC5F0\uB3C4\xB7\uC2DC\uB8CC \uCC44\uCDE8\uC77C\n\uC751\uB2F5 \uD615\uC2DD 
    JSON\xB7XML\n\uC774\uC6A9 \uC870\uAC74  \uACF5\uACF5\uB204\uB9AC \uC81C1\uC720\uD615\n\uBA54\uD0C0\uB370\uC774\uD130
    \uD655\uC778  2026-08-11\n\uC694\uCCAD \uACBD\uB85C  /B552895/rest/farmmap/getFarmmapSoilAnalysisService/getCoordinateBasedSoilAnalsInfo\n\uD544\uC218
    \uC785\uB825  serviceKey, numOfRows, pageNo, type, positionX, positionY \xB7
    year\uB294 \uC120\uD0DD\n\uD45C\uBCF8 \uD638\uCD9C  \uBBF8\uD638\uCD9C \xB7 \uC0AC\uC6A9\uC790
    \uC704\uCE58\uC640 \uD544\uC9C0 \uC2DD\uBCC4\uC790\uB97C \uC120\uD0DD\uD558\uC9C0
    \uC54A\uC74C\n\n\uC5D0\uC14B\xB7\uC790\uB8CC \uAD00\uACC4\n\uBC2D\uACE0\uB791\uC740
    \uD544\uC9C0 \uD1A0\uC591\uAC80\uC815 \uC790\uB8CC\uB97C \uC77D\uAE30 \uC2DC\uC791\uD558\uB294
    \uC2DC\uAC01 \uD45C\uBCF8\uC774\uB2E4. \uC5D0\uC14B\uC758 \uD759 \uC0C9\uC774\uB098
    \uBAA8\uC591\uC744 \uCE21\uC815\uAC12\uC73C\uB85C \uD574\uC11D\uD558\uC9C0 \uC54A\uB294\uB2E4.\n\n\uAD00\uCE21
    \uBC94\uC704\n\uC9C0\uC5ED  \uBBF8\uC218\uC9D1\n\uAE30\uC900\uAE30\uAC04  \uBBF8\uC218\uC9D1\n\uC720\uD1B5\uB2E8\uACC4 
    \uBBF8\uC218\uC9D1\n\uAD00\uCE21\uAC12  \uC2E4\uC81C \uAD00\uCE21\uAC12 \uC5C6\uC74C\n\n\uC774
    \uC790\uB8CC\uB85C \uC54C \uC218 \uC788\uB294 \uAC83\n\uD544\uC9C0 \uC2DD\uBCC4\uC790\uC640
    \uC2DC\uB8CC \uC2DC\uC810\uC774 \uB9DE\uC73C\uBA74 \uC0B0\uB3C4\xB7\uC720\uAE30\uBB3C\xB7\uC720\uD6A8\uC778\uC0B0\xB7\uC804\uAE30\uC804\uB3C4\uB3C4
    \uAC19\uC740 \uD1A0\uC591\uAC80\uC815 \uACB0\uACFC\uB97C \uC0B4\uD3B4\uBCFC \uC218
    \uC788\uB2E4.\n\n\uC774 \uC790\uB8CC\uB85C \uC54C \uC218 \uC5C6\uB294 \uAC83\n\uC774
    \uC804\uC2DC\uC7A5 \uBC2D\uACE0\uB791\uC758 \uC2E4\uC81C \uD1A0\uC591 \uC131\uBD84,
    \uC791\uBB3C \uCC98\uBC29, \uBE44\uB8CC \uD22C\uC785\uB7C9\uACFC \uD604\uC7AC
    \uACBD\uC791 \uC0AC\uC2E4\uC740 \uC54C \uC218 \uC5C6\uB2E4.\n\nSimulation \uBE44\uAD50\nSimulation
    \uD1A0\uC591 \uC0C1\uD0DC\uAC00 \uC0DD\uACA8\uB3C4 \uACF5\uACF5 \uD1A0\uC591\uAC80\uC815
    \uC6D0\uBCF8\uACFC \uBCC4\uB3C4 \uCE35\uC73C\uB85C \uBE44\uAD50\uD55C\uB2E4.\n\n\uC11C\uBC84
    \uC5F0\uACB0 \uC0C1\uD0DC\n\uC11C\uBC84 \uC5F0\uACB0 \uC804 \xB7 \uACF5\uACF5\uB370\uC774\uD130\uD3EC\uD138
    Dataset 15058655"

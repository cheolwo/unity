  m_Name: "\uC5D0\uC14B\uC5F0\uAD6CCatalog"
  m_EditorClassIdentifier: "Ssalddel.Unity.CityFarmWorldIntegration::Ssalddel.Unity.Experiments.CityFarmWorldIntegration.\uC5D0\uC14B\uC5F0\uAD6CCatalog"
  entries:
  - "\uC5F0\uAD6CId": "\uC5D0\uC14B\uC5F0\uAD6C:\uB18D\uC7A5:\uC628\uC2E4:01"
    "\uC6D0\uBCF8Guid": d18a58184e042eb4cbffba24a88ad835
    "\uD55C\uAD6D\uC5B4\uC774\uB984": "\uC628\uC2E4 01"
    "\uC5F0\uAD6C\uC0C1\uD0DC": "\uD574\uC11D\uB428"
    "\uAD00\uCC30\uB41C\uC0AC\uC2E4": "\uD22C\uBA85\uD55C \uBCBD\uACFC \uC9C0\uBD95\uC744
      \uAC00\uC9C4 \uD3D0\uC1C4\uD615 \uC7AC\uBC30 \uAC74\uBB3C\uC774\uB2E4. \uCD9C\uC785\uAD6C\uC640
      \uB0B4\uBD80 \uC7AC\uBC30 \uACF5\uAC04\uC774 \uAD6C\uBD84\uB41C\uB2E4."
    "\uD604\uC2E4\uC758\uBBF8": "\uC678\uBD80 \uAE30\uD6C4\uB97C \uADF8\uB300\uB85C
      \uB530\uB974\uC9C0 \uC54A\uACE0 \uC628\uB3C4\xB7\uC2B5\uB3C4\xB7\uAE09\uC218\uB97C
      \uC870\uC808\uD558\uBA70 \uC791\uBB3C\uC744 \uAE30\uB974\uB294 \uC2DC\uC124\uC7AC\uBC30
      \uACF5\uAC04\uC774\uB2E4."
    "\uC6D4\uB4DC\uC5ED\uD560\uD6C4\uBCF4": "\uB18D\uC7A5 \uC0DD\uC0B0\uC2DC\uC124
      \uD6C4\uBCF4. \uC544\uC9C1 \uC2E4\uC81C \uC0DD\uC0B0\uB7C9\uC774\uB098 \uC6B4\uC601
      \uC0C1\uD0DC\uB97C \uD655\uC815\uD558\uC9C0 \uC54A\uB294\uB2E4."
    "\uD568\uAED8\uB458\uC5D0\uC14B\uD6C4\uBCF4": "\uBB3C\uD0F1\uD06C, \uBB3C\uBFCC\uB9AC\uAC1C,
      \uC791\uBB3C, \uB18D\uC7A5 \uC791\uC5C5\uC790, \uC218\uD655 \uC0C1\uC790, \uC9C4\uC785\uB85C,
      \uC6B4\uC1A1 \uCC28\uB7C9"
    "\uC5F0\uACB0\uD560Data\uD6C4\uBCF4": "\uC628\uB3C4, \uC2B5\uB3C4, \uC7AC\uBC30
      \uC791\uBB3C, \uC7AC\uBC30\uBA74\uC801, \uC0DD\uC721 \uC0C1\uD0DC, \uAD00\uCE21
      \uAE30\uC900 \uC2DC\uAC01, \uC790\uB8CC \uCD9C\uCC98"
    "\uC2B9\uACA9\uD6C4\uBCF4VisualKey": farm.facility.greenhouse
  - "\uC5F0\uAD6CId": "\uC5D0\uC14B\uC5F0\uAD6C:\uB9C8\uC744:\uB2E8\uB3C5\uC8FC\uD0DD:01"
    "\uC6D0\uBCF8Guid": aba168a0966599544980000f122159b4
    "\uD55C\uAD6D\uC5B4\uC774\uB984": "\uB9C8\uC744 \uB2E8\uB3C5\uC8FC\uD0DD 01"
    "\uC5F0\uAD6C\uC0C1\uD0DC": "\uD574\uC11D\uB428"
    "\uAD00\uCC30\uB41C\uC0AC\uC2E4": "\uD604\uAD00, \uCC3D\uBB38, \uC9C0\uBD95\uACFC
      \uC0DD\uD65C \uACF5\uAC04\uC758 \uB369\uC5B4\uB9AC\uAC00 \uD55C \uCC44\uB85C
      \uAD6C\uC131\uB41C \uC800\uCE35 \uC8FC\uD0DD\uC774\uB2E4."
    "\uD604\uC2E4\uC758\uBBF8": "\uD55C \uAC00\uAD6C\uB098 \uC774\uC6C3\uC774 \uBA38\uBB3C\uBA70
      \uC2DD\uC0AC\xB7\uD734\uC2DD\xB7\uBCF4\uAD00\uACFC \uC77C\uC0C1 \uC18C\uBE44\uB97C
      \uC774\uC5B4\uAC00\uB294 \uC0DD\uD65C \uAC70\uC810\uC774\uB2E4."
    "\uC6D4\uB4DC\uC5ED\uD560\uD6C4\uBCF4": "\uB9C8\uC744 \uC8FC\uAC70 \uC7A5\uC18C
      \uD6C4\uBCF4. \uAC70\uC8FC \uC778\uC6D0, \uC18C\uC720 \uAD00\uACC4\uB098 \uC2E4\uC81C
      \uC0DD\uD65C \uC0C1\uD0DC\uB97C \uBAA8\uB378\uB9CC\uC73C\uB85C \uD655\uC815\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    "\uD568\uAED8\uB458\uC5D0\uC14B\uD6C4\uBCF4": "\uC815\uC6D0, \uC6B0\uD3B8\uD568,
      \uC4F0\uB808\uAE30\uD1B5, \uC2B9\uC6A9\uCC28, \uC8FC\uBBFC, \uBCF4\uD589\uB85C,
      \uB3D9\uB124 \uC0C1\uC810, \uBC30\uB2EC \uCC28\uB7C9"
    "\uC5F0\uACB0\uD560Data\uD6C4\uBCF4": "\uAC00\uAD6C \uC218, \uC778\uAD6C, \uC0DD\uD65C\uAD8C,
      \uAC74\uCD95\uBB3C \uC6A9\uB3C4, \uB300\uC911\uAD50\uD1B5 \uC811\uADFC\uC131,
      \uAD00\uCE21 \uAE30\uC900 \uC2DC\uAC01, \uC790\uB8CC \uCD9C\uCC98"
    "\uC2B9\uACA9\uD6C4\uBCF4VisualKey": town.place.detached-house
  - "\uC5F0\uAD6CId": "\uC5D0\uC14B\uC5F0\uAD6C:\uB3C4\uC2DC:\uC2DC\uCCAD:01"
    "\uC6D0\uBCF8Guid": 7867ba7f5410daf41b58b5427b1d9554
    "\uD55C\uAD6D\uC5B4\uC774\uB984": "\uB3C4\uC2DC \uC2DC\uCCAD 01"
    "\uC5F0\uAD6C\uC0C1\uD0DC": "\uD574\uC11D\uB428"
    "\uAD00\uCC30\uB41C\uC0AC\uC2E4": "\uB113\uC740 \uC815\uBA74\uACFC \uC911\uC559
      \uCD9C\uC785\uAD6C\uB97C \uAC00\uC9C4 \uB3C5\uB9BD\uD615 \uACF5\uACF5 \uAC74\uBB3C\uB85C
      \uC8FC\uBCC0\uC5D0\uC11C \uC911\uC2EC \uC2DC\uC124\uCC98\uB7FC \uC77D\uD78C\uB2E4."
    "\uD604\uC2E4\uC758\uBBF8": "\uC8FC\uBBFC\uACFC \uB3C4\uC2DC \uC870\uC9C1\uC774
      \uD589\uC815 \uC548\uB0B4, \uACF5\uACF5 \uC5C5\uBB34\uC640 \uC9C0\uC5ED \uC758\uC0AC\uACB0\uC815\uC744
      \uC811\uD558\uB294 \uB3C4\uC2DC \uAE30\uB2A5 \uAC70\uC810\uC774\uB2E4."
    "\uC6D4\uB4DC\uC5ED\uD560\uD6C4\uBCF4": "\uB3C4\uC2DC \uD589\uC815 \uC7A5\uC18C
      \uD6C4\uBCF4. \uC2E4\uC81C \uAE30\uAD00, \uAD00\uD560, \uBBFC\uC6D0 \uCC98\uB9AC\uB098
      \uD589\uC815 \uAD8C\uD55C\uC744 \uBAA8\uB378\uC774 \uB300\uC2E0\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    "\uD568\uAED8\uB458\uC5D0\uC14B\uD6C4\uBCF4": "\uAD11\uC7A5, \uC548\uB0B4 \uD45C\uC9C0,
      \uBC84\uC2A4 \uC815\uB958\uC7A5, \uACF5\uBB34\uC6D0, \uC8FC\uBBFC, \uB3C4\uB85C,
      \uC8FC\uCC28 \uACF5\uAC04, \uACF5\uACF5 \uAC8C\uC2DC\uD310"
    "\uC5F0\uACB0\uD560Data\uD6C4\uBCF4": "\uD589\uC815\uAD6C\uC5ED, \uACF5\uACF5\uC2DC\uC124
      \uC704\uCE58, \uAC1C\uBC29 \uC2DC\uAC04, \uAD50\uD1B5 \uC811\uADFC\uC131, \uAE30\uC900
      \uC2DC\uAC01, \uC790\uB8CC \uCD9C\uCC98"
    "\uC2B9\uACA9\uD6C4\uBCF4VisualKey": city.place.civic-hall
  - "\uC5F0\uAD6CId": "\uC5D0\uC14B\uC5F0\uAD6C:\uB18D\uC7A5:\uAC10\uC790\uC218\uD655\uC0C1\uC790:01"
    "\uC6D0\uBCF8Guid": 2131bc3845099584ebe0cb30614e96f4
    "\uD55C\uAD6D\uC5B4\uC774\uB984": "\uAC10\uC790 \uC218\uD655 \uC0C1\uC790 01"
    "\uC5F0\uAD6C\uC0C1\uD0DC": "\uD574\uC11D\uB428"
    "\uAD00\uCC30\uB41C\uC0AC\uC2E4": "\uB098\uBB34 \uC0C1\uC790 \uC548\uC5D0 \uAC10\uC790
      \uD45C\uBCF8\uC774 \uB2F4\uAE34 \uC218\uD655\uBB3C \uC18C\uD488\uC774\uB2E4.
      \uC0C1\uC790 \uC790\uCCB4\uC5D0\uB294 \uC911\uB7C9\xB7\uD488\uC9C8\xB7\uC18C\uC720\uC790
      \uC815\uBCF4\uAC00 \uC5C6\uB2E4."
    "\uD604\uC2E4\uC758\uBBF8": "\uC218\uD655\uD55C \uAC10\uC790\uB97C \uC120\uBCC4\xB7\uBCF4\uAD00\xB7\uC0C1\uCC28\xB7\uD310\uB9E4
      \uAC19\uC740 \uB2E4\uC74C \uC791\uC5C5\uC73C\uB85C \uC778\uACC4\uD558\uB294
      \uBB3C\uB9AC\uC801 \uC6A9\uAE30\uB2E4."
    "\uC6D4\uB4DC\uC5ED\uD560\uD6C4\uBCF4": "\uC218\uD655\uBB3C \uC778\uACC4 \uD45C\uC2DD
      \uD6C4\uBCF4. \uBCF4\uC774\uB294 \uAC10\uC790 \uC218\uB098 \uC0C1\uC790 \uC218\uB97C
      \uC2E4\uC81C HarvestLot \uC218\uB7C9\uC73C\uB85C \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294\uB2E4."
    "\uD568\uAED8\uB458\uC5D0\uC14B\uD6C4\uBCF4": "\uAC10\uC790\uBC2D, \uB18D\uC7A5
      \uC791\uC5C5\uC790, \uC800\uC6B8, \uD314\uB808\uD2B8, \uD2B8\uB7ED, \uBB3C\uB958\uC13C\uD130,
      \uC2DC\uC7A5 \uD310\uB9E4\uB300, \uC800\uC7A5\uACE0"
    "\uC5F0\uACB0\uD560Data\uD6C4\uBCF4": "KAMIS \uAC10\uC790 \uAC00\uACA9 \uAD00\uCE21,
      \uC870\uC0AC\uC77C, \uC720\uD1B5\uB2E8\uACC4, \uD488\uC885\xB7\uB4F1\uAE09\xB7\uB2E8\uC704,
      \uC6D0\uCC9C revision"
    "\uC2B9\uACA9\uD6C4\uBCF4VisualKey": farm.harvest.potato-box
  - "\uC5F0\uAD6CId": "\uC5D0\uC14B\uC5F0\uAD6C:\uB18D\uC7A5:KAMIS\uC791\uBB3C:100:141"
    "\uC6D0\uBCF8Guid": 8346ee13438b80a4fadf27ff5f7a4d8f
    "\uD55C\uAD6D\uC5B4\uC774\uB984": "\uCF69 \uB300\uD45C \uC791\uBB3C"
    "\uC5F0\uAD6C\uC0C1\uD0DC": "\uD574\uC11D\uB428"
    "\uAD00\uCC30\uB41C\uC0AC\uC2E4": "POLYGON Farm\uC774 \uCF69 \uC774\uB984\uC73C\uB85C
      \uC81C\uACF5\uD558\uB294 \uB300\uD45C \uC7AC\uBC30\xB7\uC218\uD655\uBB3C \uC5D0\uC14B\uC774\uB2E4.
      \uC678\uD615\uB9CC\uC73C\uB85C \uD488\uC885\xB7\uB4F1\uAE09\xB7\uC911\uB7C9\xB7\uC0DD\uC721
      \uC0C1\uD0DC\uB294 \uC54C \uC218 \uC5C6\uB2E4."
    "\uD604\uC2E4\uC758\uBBF8": "KAMIS\uC758 \uCF69 \uD488\uBAA9\uC744 \uD604\uC2E4
      \uAD00\uCE21\uACFC \uD568\uAED8 \uC0B4\uD3B4\uBCF4\uAE30 \uC704\uD55C \uC2DC\uAC01
      \uD45C\uBCF8\uC774\uB2E4."
    "\uC6D4\uB4DC\uC5ED\uD560\uD6C4\uBCF4": "KAMIS \uC791\uBB3C \uBAA8\uD310\uC758
      \uC5F0\uAD6C \uD45C\uBCF8. \uCD9C\uCC98\uC640 \uAD00\uCE21 \uBC94\uC704\uB97C
      \uAD6C\uCCB4\uD654\uD558\uAE30 \uC804\uC5D0\uB294 \uC2E4\uC81C Farm Scene\uC758
      \uC0DD\uC0B0 \uC0C1\uD0DC\uB85C \uC2B9\uACA9\uD558\uC9C0 \uC54A\uB294\uB2E4."
    "\uD568\uAED8\uB458\uC5D0\uC14B\uD6C4\uBCF4": "\uC7AC\uBC30 \uAD6C\uC5ED, \uB18D\uC7A5
      \uC791\uC5C5\uC790, \uC218\uD655 \uC0C1\uC790, \uC800\uC6B8, \uC800\uC7A5\uACE0,
      \uC6B4\uC1A1 \uCC28\uB7C9, \uD310\uB9E4\uB300"
    "\uC5F0\uACB0\uD560Data\uD6C4\uBCF4": "KAMIS \uBD84\uB958 100, \uD488\uBAA9 141,
      \uC9C0\uC5ED, \uC870\uC0AC\uC77C, \uC720\uD1B5\uB2E8\uACC4, \uD488\uC885\xB7\uB4F1\uAE09\xB7\uB2E8\uC704,
      \uD45C\uBCF8 \uC218, \uCD9C\uCC98 revision"
    "\uC2B9\uACA9\uD6C4\uBCF4VisualKey": farm.product.bean

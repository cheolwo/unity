    "\uD55C\uAD6D\uC5B4\uC774\uB984": "\uBC2D\uACE0\uB791 \uD1A0\uC591 \uD45C\uBCF8"
    "\uC5F0\uAD6C\uC0C1\uD0DC": "\uD574\uC11D\uB428"
    "\uAD00\uCC30\uB41C\uC0AC\uC2E4": "\uC5EC\uB7EC \uC904\uC758 \uC774\uB791\uACFC
      \uACE0\uB791\uC774 \uBC18\uBCF5\uB418\uB294 \uACBD\uC791\uC9C0 \uBC14\uB2E5
      \uC5D0\uC14B\uC774\uB2E4. \uD759\uC758 \uC131\uBD84\uC774\uB098 \uC2E4\uC81C
      \uD544\uC9C0 \uACBD\uACC4\uB294 \uD45C\uD604\uD558\uC9C0 \uC54A\uB294\uB2E4."
    "\uD604\uC2E4\uC758\uBBF8": "\uC791\uBB3C\uC744 \uC2EC\uACE0 \uBB3C\uACFC \uC591\uBD84\uC744
      \uAD00\uB9AC\uD558\uB294 \uD1A0\uC591 \uAE30\uBC18 \uC0DD\uC0B0 \uACF5\uAC04\uC774\uB2E4."
    "\uC6D4\uB4DC\uC5ED\uD560\uD6C4\uBCF4": "\uD544\uC9C0 \uD1A0\uC591\uAC80\uC815
      \uC790\uB8CC\uB97C \uC77D\uAE30 \uC2DC\uC791\uD558\uB294 \uC7A5\uC18C \uD45C\uBCF8.
      \uC5D0\uC14B\uC758 \uC0C9\uC73C\uB85C \uD1A0\uC591 \uC0C1\uD0DC\uB97C \uD310\uC815\uD558\uC9C0
      \uC54A\uB294\uB2E4."
    "\uD568\uAED8\uB458\uC5D0\uC14B\uD6C4\uBCF4": "\uAC10\uC790 \uC7AC\uBC30\uCCB4,
      \uB18D\uC7A5 \uC791\uC5C5\uC790, \uAD00\uC218 \uC124\uBE44, \uC218\uD655 \uC0C1\uC790,
      \uB18D\uB85C, \uD1A0\uC591 \uC2DC\uB8CC \uD45C\uC9C0"
    "\uC5F0\uACB0\uD560Data\uD6C4\uBCF4": "\uD544\uC9C0 \uC2DD\uBCC4\uC790, \uC2DC\uB8CC
      \uCC44\uCDE8\uC77C, \uC0B0\uB3C4, \uC720\uAE30\uBB3C, \uC720\uD6A8\uC778\uC0B0,
      \uC804\uAE30\uC804\uB3C4\uB3C4, \uCD9C\uCC98\uC640 \uC774\uC6A9\uC870\uAC74"

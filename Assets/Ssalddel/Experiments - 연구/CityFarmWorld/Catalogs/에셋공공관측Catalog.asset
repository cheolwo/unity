    "\uC804\uC2DC\uBAA8\uC74C": 
    "\uC54C\uC218\uC788\uB294\uAC83": "\uAC10\uC790 \uD488\uBAA9\uC758 \uC870\uC0AC\uC77C\xB7\uC720\uD1B5\uB2E8\uACC4\xB7\uD488\uC885\xB7\uB4F1\uAE09\xB7\uB2E8\uC704\uAC00
      \uBCF4\uC874\uB41C \uAC00\uACA9 \uAD00\uCE21\uC744 \uC5F0\uACB0\uD558\uBA74
      \uC9C0\uC5ED\uACFC \uAE30\uAC04\uBCC4 \uAC00\uACA9 \uBC94\uC704\uB97C \uC0B4\uD3B4\uBCFC
      \uC218 \uC788\uB2E4."
    "\uC54C\uC218\uC5C6\uB294\uAC83": "\uC774 \uC0C1\uC790\uC758 \uC2E4\uC81C \uC911\uB7C9\xB7\uD488\uC9C8\xB7\uC0B0\uC9C0\xB7\uC18C\uC720\uC790\xB7\uD310\uB9E4\uAC00\uACA9\uACFC
      \uD2B9\uC815 \uB18D\uC7A5\uC758 \uCD9C\uD558 \uC0AC\uC2E4\uC740 \uC54C \uC218
      \uC5C6\uB2E4."
    "Simulation\uBE44\uAD50": "\uAE30\uC874 2,450 KRW/kg \uAC12\uC740 Simulation
      Fixture\uC774\uBA70 \uC2E4\uC81C KAMIS \uAD00\uCE21\uAC12\uC774 \uC544\uB2C8\uB2E4."
